rules_version = '2';
// Regras de acesso do app Pró-Treino / Ficha de Treino.
// Papéis:
//  - Gestor: UID na coleção "gestores" (criada pelo Console do Firebase). Vê e altera tudo.
//  - Personal: UID em "personais" (liberado pelo gestor). Vê só alunos com vínculo ativo.
//  - Aluno: vê e altera só os próprios dados. O vínculo com um Personal exige aceite das duas partes.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function pth(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    function isG() { return signed() && exists(pth('gestores', me())); }
    function isP() { return signed() && exists(pth('personais', me())); }
    function myPersonal() { return get(pth('perfis', me())).data.get('personalId', ''); }
    function novo() { return request.resource.data; }
    function antigo() { return resource.data; }
    function pid(d) { return d.get('personalId', ''); }
    function so(campos) { return novo().diff(antigo()).affectedKeys().hasOnly(campos); }
    function alunoDoPersonal(aid) {
      return aid != '' && get(pth('perfis', aid)).data.get('personalId', '') == me();
    }
    // O aluno só passa a apontar para um Personal se existir vínculo ATIVO entre os dois.
    function vinculoOK(d) {
      return d.get('vinculoId', '') != ''
        && get(pth('vinculos', d.get('vinculoId', ''))).data.status == 'ativo'
        && get(pth('vinculos', d.get('vinculoId', ''))).data.alunoId == me()
        && get(pth('vinculos', d.get('vinculoId', ''))).data.personalId == pid(d);
    }
    function emailOK(d) {
      return request.auth.token.email != null && request.auth.token.email_verified == true
        && d.get('alunoEmail', '') == request.auth.token.email.lower();
    }
    function souAluno(d) { return d.get('alunoId', '') == me() || (d.get('alunoId', '') == '' && emailOK(d)); }

    match /gestores/{uid} {
      allow read: if signed() && me() == uid;
      allow write: if false;
    }

    // Código de convite: o próprio Personal cria o seu (nunca sobrescreve um existente).
    match /convites/{codigo} {
      allow read: if signed();
      allow create: if isG() || (signed() && novo().personalId == me()
        && existsAfter(pth('personais', me())) && getAfter(pth('personais', me())).data.codigo == codigo);
      allow update, delete: if isG();
    }

    // Denúncias de perfis na busca: qualquer usuário cria; só o gestor lê e trata.
    match /denuncias/{id} {
      allow create: if signed() && novo().autorId == me() && novo().status == 'aberta';
      allow read, update, delete: if isG();
    }

    // Perfil profissional do Personal (público para usuários logados).
    match /personais/{uid} {
      allow read: if signed();
      // Autocadastro: o usuário cria o próprio registro de Personal, sem CREF conferido.
      allow create: if isG() || (signed() && me() == uid && novo().get('crefVerificado', false) == false
        && novo().get('codigo', '') != '' && getAfter(pth('convites', novo().codigo)).data.personalId == me());
      allow delete: if isG();
      allow update: if isG()
        || (isP() && me() == uid
            && so(['publico', 'bio', 'especialidades', 'cidade', 'uf', 'bairros', 'academias', 'modalidade', 'faixaPreco', 'contato', 'cref', 'crefVerificado', 'nome', 'atualizado', 'foto'])
            && novo().get('crefVerificado', false) == (novo().get('cref', '') == antigo().get('cref', '') ? antigo().get('crefVerificado', false) : false));
    }

    match /academias/{id} {
      allow read: if signed() && (antigo().get('aprovada', false) == true || antigo().get('sugeridaPor', '') == me() || isG());
      allow create: if isG() || (isP() && novo().get('aprovada', false) == false && novo().get('sugeridaPor', '') == me());
      allow update, delete: if isG();
    }

    match /vinculos/{id} {
      allow read: if isG() || (signed() && (antigo().get('alunoId', '') == me() || emailOK(antigo()) || antigo().get('personalId', '') == me()));
      allow create: if isG() || (signed() && novo().status == 'pendente' && (
            (novo().iniciadoPor == 'aluno' && novo().alunoId == me() && exists(pth('personais', novo().personalId)))
         || (novo().iniciadoPor == 'personal' && isP() && novo().personalId == me())));
      allow update: if isG() || (signed() && novo().personalId == antigo().personalId && (
            (souAluno(antigo()) && novo().alunoId == me() && (
                 (antigo().status == 'pendente' && antigo().iniciadoPor == 'personal' && novo().status in ['ativo', 'recusado'])
              || (antigo().status == 'pendente' && antigo().iniciadoPor == 'aluno' && novo().status == 'cancelado')
              || (antigo().status == 'ativo' && novo().status in ['ativo', 'encerrado'])
              || (antigo().status in ['recusado', 'encerrado', 'cancelado'] && novo().status == 'pendente' && novo().iniciadoPor == 'aluno')))
         || (antigo().personalId == me() && isP() && novo().alunoId == antigo().alunoId && (
                 (antigo().status == 'pendente' && antigo().iniciadoPor == 'aluno' && novo().status in ['ativo', 'recusado'])
              || (antigo().status == 'pendente' && antigo().iniciadoPor == 'personal' && novo().status == 'cancelado')
              || (antigo().status == 'ativo' && novo().status == 'encerrado')
              || (antigo().status in ['recusado', 'encerrado', 'cancelado'] && novo().status == 'pendente' && novo().iniciadoPor == 'personal')))));
      allow delete: if isG();
    }

    match /perfis/{uid} {
      allow read: if isG() || (signed() && me() == uid) || (isP() && pid(antigo()) == me());
      allow create: if isG()
        || (signed() && me() == uid && novo().papel == 'aluno' && pid(novo()) == '')
        || (isP() && novo().papel == 'aluno' && pid(novo()) == '');
      allow update: if isG()
        || (signed() && me() == uid
            && (novo().papel == antigo().papel
                || (novo().papel == 'personal' && existsAfter(pth('personais', me())))
                || (novo().papel == 'aluno' && !existsAfter(pth('personais', me()))))
            && novo().get('ativo', true) == antigo().get('ativo', true)
            && (pid(novo()) == pid(antigo()) || pid(novo()) == '' || vinculoOK(novo())))
        || (isP() && pid(antigo()) == me() && pid(novo()) == me() && novo().papel == antigo().papel)
        || (isP() && pid(antigo()) == me() && pid(novo()) == '' && so(['personalId', 'convite', 'vinculoId']));
      allow delete: if isG();
    }

    match /fichas/{id} {
      allow read: if isG()
        || (signed() && antigo().get('alunoId', '') == me())
        || (signed() && antigo().get('global', false) == true)
        || (isP() && pid(antigo()) == me())
        // Modelo do Personal: só para os alunos dele, e só se ele marcar "Disponível para meus alunos".
        || (signed() && antigo().get('modelo', false) == true && antigo().get('alunos', false) == true
            && pid(antigo()) != '' && pid(antigo()) == myPersonal());
      allow create, update: if isG()
        || (signed() && novo().get('alunoId', '') == me()
            && novo().get('modelo', false) != true && novo().get('global', false) != true
            && pid(novo()) == myPersonal()
            && (resource == null || antigo().get('alunoId', '') == me()))
        || (isP() && pid(novo()) == me() && novo().get('global', false) != true
            && (resource == null || pid(antigo()) == me())
            && (novo().get('modelo', false) == true || alunoDoPersonal(novo().get('alunoId', ''))))
        || (isP() && resource != null && pid(antigo()) == me() && pid(novo()) == '' && so(['personalId']));
      allow delete: if isG()
        || (signed() && antigo().get('alunoId', '') == me())
        || (isP() && pid(antigo()) == me());
    }

    // Treino em andamento (um documento por aluno, id = UID do aluno). Só o aluno e o Personal
    // com vínculo ativo leem e gravam, para continuar o treino no celular de um ou de outro.
    match /andamento/{aid} {
      allow read: if isG() || (signed() && me() == aid) || (isP() && pid(antigo()) == me());
      allow create, update: if isG()
        || (signed() && me() == aid && novo().alunoId == aid && pid(novo()) == myPersonal())
        || (isP() && novo().alunoId == aid && pid(novo()) == me() && alunoDoPersonal(aid));
      allow delete: if isG() || (signed() && me() == aid) || (isP() && alunoDoPersonal(aid));
    }

    match /sessions/{id} {
      allow read: if isG()
        || (signed() && antigo().get('alunoId', '') == me())
        || (isP() && pid(antigo()) == me());
      allow create, update: if isG()
        || (signed() && novo().get('alunoId', '') == me() && pid(novo()) == myPersonal()
            && (resource == null || antigo().get('alunoId', '') == me()))
        || (isP() && pid(novo()) == me() && (resource == null || pid(antigo()) == me())
            && alunoDoPersonal(novo().get('alunoId', '')))
        || (isP() && resource != null && pid(antigo()) == me() && pid(novo()) == '' && so(['personalId']));
      allow delete: if isG()
        || (signed() && antigo().get('alunoId', '') == me())
        || (isP() && pid(antigo()) == me());
    }

    // ================= Comunidades =================
    // Criadas por aluno ou Personal. Entrada só com aprovação do criador. Ninguém lê treinos de outra
    // pessoa: cada membro grava o próprio placar, e as regras recusam números implausíveis.
    function comDoc(cid) { return get(pth('comunidades', cid)).data; }
    function mPath(cid, uid) { return /databases/$(database)/documents/comunidades/$(cid)/membros/$(uid); }
    function souAtivo(cid) { return signed() && exists(mPath(cid, me())) && get(mPath(cid, me())).data.status == 'ativo'; }
    function souCriador(cid) { return signed() && comDoc(cid).criadorId == me(); }
    function textoOK(t, max) { return t is string && t.size() <= max; }
    function placarOK(p) {
      return p.keys().hasOnly(['sem', 'semN', 'mes', 'mesN', 'kmSem', 'kmMes', 'seq', 'at'])
        && p.get('semN', 0) is number && p.get('semN', 0) >= 0 && p.get('semN', 0) <= 14
        && p.get('mesN', 0) is number && p.get('mesN', 0) >= 0 && p.get('mesN', 0) <= 62
        && p.get('kmSem', 0) is number && p.get('kmSem', 0) >= 0 && p.get('kmSem', 0) <= 300
        && p.get('kmMes', 0) is number && p.get('kmMes', 0) >= 0 && p.get('kmMes', 0) <= 1000
        && p.get('seq', 0) is number && p.get('seq', 0) >= 0 && p.get('seq', 0) <= 520;
    }

    function progOK(d, n) {
      return (d.tipo == 'treinos' && n <= ((d.fim - d.inicio) / 86400000 + 1) * 2)
        || (d.tipo == 'km' && n <= ((d.fim - d.inicio) / 86400000 + 1) * 50)
        || (d.tipo == 'semanas' && n <= (d.fim - d.inicio) / 604800000 + 2);
    }

    match /codigosCom/{codigo} {
      allow get: if signed();
      allow create: if signed() && getAfter(pth('comunidades', novo().cid)).data.criadorId == me();
      allow delete: if isG() || (signed() && get(pth('comunidades', antigo().cid)).data.criadorId == me());
    }

    match /comunidades/{cid} {
      allow get: if signed();
      allow list: if isG();
      allow create: if signed() && novo().criadorId == me()
        && textoOK(novo().nome, 40) && novo().nome.size() >= 2 && textoOK(novo().get('desc', ''), 200)
        && textoOK(novo().get('aviso', ''), 280);
      allow update: if isG() || (signed() && antigo().criadorId == me()
        && textoOK(novo().nome, 40) && novo().nome.size() >= 2 && textoOK(novo().get('desc', ''), 200)
        && textoOK(novo().get('aviso', ''), 280)
        && (novo().criadorId == me()
            || (exists(mPath(cid, novo().criadorId)) && get(mPath(cid, novo().criadorId)).data.status == 'ativo')));
      allow delete: if isG() || (signed() && antigo().criadorId == me());

      match /membros/{uid} {
        allow read: if isG() || (signed() && me() == uid) || souCriador(cid)
          || (souAtivo(cid) && antigo().status == 'ativo');
        // Pedido de entrada (pendente) ou o próprio criador ao criar a comunidade.
        allow create: if signed() && me() == uid && novo().uid == uid
          && textoOK(novo().nome, 30) && novo().nome.size() >= 1
          && !novo().keys().hasAny(['placar', 'zeradoEm'])
          && (novo().status == 'pendente'
              || (novo().status == 'ativo' && getAfter(pth('comunidades', cid)).data.criadorId == me()));
        allow update: if
          // O membro ativo atualiza o próprio nome e placar (com limites de bom senso).
             (signed() && me() == uid && antigo().status == 'ativo' && so(['nome', 'placar'])
               && textoOK(novo().nome, 30) && novo().nome.size() >= 1 && placarOK(novo().get('placar', {})))
          // Quem foi recusado pode pedir de novo.
          || (signed() && me() == uid && antigo().status == 'recusado' && novo().status == 'pendente'
               && so(['status', 'nome', 'pedido']) && textoOK(novo().nome, 30))
          // O criador aprova, recusa ou zera o placar de outro membro.
          || (souCriador(cid) && me() != uid && so(['status', 'entrou', 'placar', 'zeradoEm'])
               && novo().status in ['ativo', 'recusado']
               && (novo().get('placar', {}) == antigo().get('placar', {}) || novo().get('placar', {}).size() == 0))
          || isG();
        allow delete: if isG() || (signed() && me() == uid) || souCriador(cid);
      }

      match /posts/{pid} {
        allow read: if isG() || souAtivo(cid);
        allow create: if souAtivo(cid) && novo().autorId == me()
          && novo().keys().hasOnly(['autorId', 'autorNome', 'texto', 'tipo', 'criado', 'reacoes'])
          && textoOK(novo().texto, 280) && novo().texto.size() >= 1 && textoOK(novo().autorNome, 40)
          && novo().tipo in ['texto', 'checkin'] && novo().get('reacoes', {}).size() == 0;
        allow update: if souAtivo(cid) && so(['reacoes'])
          && novo().reacoes.diff(antigo().get('reacoes', {})).affectedKeys().hasOnly([me()])
          && (!(me() in novo().reacoes) || novo().reacoes[me()] in ['👏', '🔥', '💪']);
        allow delete: if isG() || (signed() && antigo().autorId == me()) || souCriador(cid);
      }

      match /desafios/{did} {
        allow read: if isG() || souAtivo(cid);
        allow create, update: if souCriador(cid)
          && textoOK(novo().titulo, 60) && novo().titulo.size() >= 2
          && novo().tipo in ['treinos', 'km', 'semanas']
          && novo().meta is number && novo().meta > 0 && novo().meta <= 5000
          && novo().inicio is number && novo().fim is number
          && novo().fim > novo().inicio && novo().fim - novo().inicio <= 366 * 86400000;
        allow delete: if isG() || souCriador(cid);

        // Progresso de cada membro: até 2 treinos por dia, 50 km por dia e o número de semanas do período.
        match /prog/{uid} {
          allow read: if isG() || souAtivo(cid);
          allow create, update: if signed() && me() == uid && souAtivo(cid)
            && novo().keys().hasOnly(['n', 'nome', 'at']) && novo().n is number && novo().n >= 0
            && progOK(get(/databases/$(database)/documents/comunidades/$(cid)/desafios/$(did)).data, novo().n);
          allow delete: if isG() || (signed() && me() == uid) || souCriador(cid);
        }
      }
    }
  }
}
